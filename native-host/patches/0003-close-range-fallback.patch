From: OpenCode Android Full contributors
Subject: [PATCH] Recognize close_range and report ENOSYS for libc fallback

Intercept close_range as a known guest syscall instead of allowing an
Android seccomp trap at an unrecognized number during subprocess setup.
The host sandbox remains enforced; guest libraries use their documented
per-descriptor fallback.

--- a/src/syscall/sysnums.list
+++ b/src/syscall/sysnums.list
@@ -41,6 +41,7 @@
 SYSNUM(clone)
 SYSNUM(clone3)
 SYSNUM(close)
+SYSNUM(close_range)
 SYSNUM(connect)
 SYSNUM(copy_file_range)
 SYSNUM(creat)
--- a/src/syscall/sysnums-arm64.h
+++ b/src/syscall/sysnums-arm64.h
@@ -279,6 +279,7 @@
 	[ 290 ] = PR_pkey_free,
 	[ 291 ] = PR_statx,
 	[ 435 ] = PR_clone3,
+	[ 436 ] = PR_close_range,
 	[ 437 ] = PR_openat2,
 	[ 439 ] = PR_faccessat2,
 	[ 428 ] = PR_open_tree,
--- a/src/syscall/sysnums-x86_64.h
+++ b/src/syscall/sysnums-x86_64.h
@@ -335,6 +335,7 @@
 	[ 331 ] = PR_pkey_free,
 	[ 332 ] = PR_statx,
         [ 435 ] = PR_clone3,
+	[ 436 ] = PR_close_range,
 	[ 437 ] = PR_openat2,
 	[ 439 ] = PR_faccessat2,
 	[ 428 ] = PR_open_tree,
--- a/src/syscall/seccomp.c
+++ b/src/syscall/seccomp.c
@@ -385,6 +385,7 @@
 	{ PR_clone,		0 },
 	{ PR_clone3,		0 },
 	{ PR_close,		0 },
+	{ PR_close_range,	FILTER_SYSEXIT },
 	{ PR_connect,		0 },
 	{ PR_creat,		0 },
 	{ PR_recvfrom,		0 },
--- a/src/syscall/enter.c
+++ b/src/syscall/enter.c
@@ -2903,6 +2903,10 @@
 	/* fchmodat2 (Linux 6.6) is not translated.  ENOSYS makes the C
 	 * library fall back to its fchmodat emulation, as on older kernels;
 	 * untranslated it fails with ENOENT and breaks package extraction.  */
+	/* close_range may be trapped by Android while a vfork child masks
+	 * signals. Handle it before the host kernel; libc/Python can then
+	 * use their ordinary close()/fcntl() fallback. */
+	case PR_close_range:
 	case PR_fchmodat2:
 		status = -ENOSYS;
 		break;
